# ---- Database (Neon / Supabase / local Postgres) ----
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Auth (admin panel) ----
AUTH_SECRET=""

# ---- Email (contact form) — Resend (optional) ----
